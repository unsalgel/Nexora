# Compose bu dosyayı otomatik okur. dotnet run için scripts/Start-LocalApi.ps1 kullanılır.
# Gerçek değerleri .env içine yazın; bu örnek ve gerçek dosya API tarafından otomatik yüklenmez.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=NexoraDb
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
PGADMIN_EMAIL=admin@nexora.local
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_AT_LEAST_32_BYTES
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@nexora.local
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DemoSeedEnabled=false
Database__AutoMigrate=false
JwtSettings__Issuer=NexoraApi
JwtSettings__Audience=NexoraClient
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7
EmailSettings__Host=
EmailSettings__Port=587
EmailSettings__UserName=
EmailSettings__Password=
EmailSettings__EnableSsl=true
EmailSettings__SenderEmail=noreply@nexora.local
EmailSettings__SenderName=Nexora
Frontend__BaseUrl=http://localhost:5173
# Frontend VITE_ ayarları her frontend'in kendi .env.local dosyasına yazılır.
# VITE_API_URL=http://localhost:5285/api
# VITE_BACKEND_URL=http://localhost:5285

# Iyzico Odeme Ag Gecidi (Sandbox Test Ortami)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:5285/api/payments/iyzico-callback
