# ==============================================================================
# Nexora E-Ticaret Platformu - Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Kullanım: Bu dosyayı '.env' olarak kopyalayın ve kendi değerlerinizle güncelleyin.
# Önemli: Gerçek gizli anahtarları ve şifreleri asla git deposuna göndermeyin!

# ------------------------------------------------------------------------------
# 1. PostgreSQL Veritabanı Yapılandırması (Docker Compose & API)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=YourStrongDbPassword123!
DB_NAME=NexoraDb

# ------------------------------------------------------------------------------
# 2. Redis Önbellek Yapılandırması (Docker Compose & API)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=YourStrongRedisPassword123!

# ------------------------------------------------------------------------------
# 3. pgAdmin Yönetim Arayüzü (Docker Compose)
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=admin@nexora.local
PGADMIN_PASSWORD=YourStrongPgAdminPassword123!

# ------------------------------------------------------------------------------
# 4. JWT & Güvenlik Yapılandırması
# ------------------------------------------------------------------------------
# En az 32 karakterlik (256-bit) rastgele güvenli anahtar üretiniz
JWT_SECRET_KEY=YourSuperSecretKeyWithMinimum32CharactersLength2026!
JWT_ISSUER=NexoraApi
JWT_AUDIENCE=NexoraClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# 5. Admin Tohumlama (Seeder) Güvenliği
# ------------------------------------------------------------------------------
# Canlı ortamda tohumlama yapmak istiyorsanız 'true' yapınız; varsayılan: false
ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@nexora.com
ADMIN_SEED_PASSWORD=YourSecureAdminPassword123*

# ------------------------------------------------------------------------------
# 6. E-posta (SMTP) Yapılandırması
# ------------------------------------------------------------------------------
# SMTP bilgileri boş bırakılırsa e-postalar konsola/loglara simüle edilir
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_ENABLE_SSL=true
SMTP_SENDER_EMAIL=noreply@nexora.com
SMTP_SENDER_NAME=Nexora

# ------------------------------------------------------------------------------
# 7. Ön Yüz (Frontend & Admin) API Bağlantısı
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000
